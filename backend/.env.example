# ─── Django ──────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── ML Model ────────────────────────────────────────────────────────────────
# After training in Colab, place the .pkl here:
PHISH_MODEL_PATH=ml/models/phishing_rf_model.pkl

# ─── Blockchain ───────────────────────────────────────────────────────────────
# Local Hardhat node (default):
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# After running `npm run deploy:local` in /contracts, copy the address here:
CONTRACT_ADDRESS=
# Path to PhishRegistry.json (ABI + address) written by deploy.js:
CONTRACT_ABI_PATH=../contracts/PhishRegistry.json
# Private key of the deployer account (Hardhat test key — replace for production):
OWNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ─── Testnet (Sepolia) ───────────────────────────────────────────────────────
# BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
# CONTRACT_ADDRESS=0xYourDeployedContractAddress
# OWNER_PRIVATE_KEY=0xYourWalletPrivateKey
